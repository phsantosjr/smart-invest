# Copie para .env em backend/: cp .env.example .env

# --- PostgreSQL 18 (compose service: db) ---
POSTGRES_DB=smart_invest
POSTGRES_USER=smart_invest
POSTGRES_PASSWORD=smart_invest_change_me
POSTGRES_PORT=25030

# URLs para o backend FastAPI (async SQLAlchemy + asyncpg)
DATABASE_URL=postgresql+asyncpg://smart_invest:smart_invest_change_me@localhost:25030/smart_invest
DATABASE_URL_SYNC=postgresql://smart_invest:smart_invest_change_me@localhost:25030/smart_invest

# --- Redis (cache de cotações, rate limit, etc.) ---
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# --- Profile "tools" (adminer, redisinsight) ---
ADMINER_PORT=8080
REDISINSIGHT_PORT=5540

# --- API FastAPI ---
JWT_SECRET_KEY=dev-change-me-use-openssl-rand-hex-32
JWT_ACCESS_EXPIRE_MINUTES=60
JWT_2FA_CHALLENGE_EXPIRE_MINUTES=5
TOTP_ISSUER_NAME=Smart Invest
API_PORT=8000

# --- Cotações de mercado (BRAPI + fallback yfinance) ---
MARKET_QUOTE_PROVIDER=mock
BRAPI_TOKEN=
MARKET_QUOTE_FALLBACK_ENABLED=true
MARKET_QUOTE_SCHEDULE_ENABLED=true
MARKET_QUOTE_SCHEDULE_TIMEZONE=America/Sao_Paulo
MARKET_QUOTE_SCHEDULE_HOUR=19
MARKET_QUOTE_SCHEDULE_MINUTE=0